# Safe to expose to the browser. Find both values in Supabase -> Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Operator Mode does not require a service-role or secret key in the app.
# Never add SUPABASE_SERVICE_ROLE_KEY to Vercel for this client application.
